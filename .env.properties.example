# Copier ce fichier en .env.properties (ignoré par Git) et remplir les vraies valeurs.
# Toutes les valeurs ci-dessous sont FACTICES.

# --- Super admin (créé au premier démarrage s'il n'existe pas en base) ---
SUPER_ADMIN_EMAIL=proprietaire@exemple.com
SUPER_ADMIN_PASSWORD=ChangezMoi123!

# --- Base de données ---
DB_URL=jdbc:postgresql://localhost:5434/batulo
DB_USERNAME=batulo
DB_PASSWORD=batulo

# --- JWT : au moins 32 caractères (256 bits) ---
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-64-caracteres-minimum

# --- Stripe (mode TEST : clés sk_test_...) ---
STRIPE_SECRET_KEY=sk_test_remplacer
STRIPE_WEBHOOK_SECRET=whsec_remplacer
STRIPE_PUBLISHABLE_KEY=pk_test_remplacer
STRIPE_CURRENCY=cad

# --- Courriel (Mailpit en local : SMTP 1025, interface http://localhost:8025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=Batulo <no-reply@batulo.local>

# --- Profil Spring : dev active la route de test /api/dev (carte pm_card_visa) ---
SPRING_PROFILES_ACTIVE=dev

# --- Serveur ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
